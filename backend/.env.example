# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ai_youtube_automation

# JWT / Auth
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000

# AI providers (Step 3+)
# Provider selector for AI metadata/Q&A: "groq" (default) or "ollama"
AI_PROVIDER=groq
# Fast model: scripts/lesson narration (speed). Quality model: metadata/translation (accuracy).
AI_MODEL_FAST=qwen/qwen3.8-27b
AI_MODEL_QUALITY=openai/gpt-oss-120b
GROQ_API_KEY=

# Free/local Ollama models (optional; used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2

GEMINI_API_KEY=

# YouTube OAuth (Step 5+)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/auth/youtube/callback

# Stripe (monthly subscriptions - user dashboard phase)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Cloudinary (video storage / delivery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ai-youtube-automation
