# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ai_youtube_automation

# JWT / Auth
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000

# AI providers (Step 3+)
# Provider selector for AI metadata/Q&A: "groq" (default) or "ollama"
AI_PROVIDER=ollama
# Fast model: scripts/lesson narration (speed). Quality model: metadata/translation (accuracy).
AI_MODEL_FAST=qwen2.5:7b
AI_MODEL_QUALITY=qwen2.5:7b
GROQ_API_KEY=

# CrowLLM (OpenAI-compatible aggregator, many free models; used when AI_PROVIDER=crowllm)
CROWLLM_API_KEY=
CROWLLM_BASE_URL=https://crowllm.com/v1
# Optional: override the model. Defaults: gpt-4o-mini:free (fast) / qwen-3.6-plus:free (quality).
CROWLLM_MODEL=

# Free/local Ollama models (optional; used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b

GEMINI_API_KEY=

# YouTube OAuth (Step 5+)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/auth/youtube/callback

# Stripe (monthly subscriptions - user dashboard phase)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Cloudinary (video storage / delivery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ai-youtube-automation

# Scheduled publishing queue (YouTube) - 2-3 videos per day by default
PUBLISH_QUEUE_ENABLED=1
PUBLISH_QUEUE_INTERVAL_MS=300000
PUBLISH_VIDEOS_PER_DAY=3
PUBLISH_GAP_HOURS=7
PUBLISH_START_HOUR=9
PUBLISH_RETRY_HOUR=10
PUBLISH_MIN_LEAD_MINUTES=30
PUBLISH_SCHEDULING_MODE=youtube
PUBLISH_MAX_ATTEMPTS=5



